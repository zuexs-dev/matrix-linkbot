# Copy to /etc/matrix-link-bot.env (chmod 600, owned by root)

# Homeserver URL and bot account
HOMESERVER=https://matrix.example.org
BOT_USER=@linkbot:example.org
BOT_PASSWORD=change-me

# Inline video cap (MB). YouTube steps resolution down to fit.
MAX_MB=100
# Cap (MB) for long videos sent as a file or as audio
FILE_MAX_MB=500
# YouTube videos longer than this (minutes) get the ✅ / 🎵 / ❌ prompt
YT_MAX_MIN=30

# Optional: copy every delivered file here. Comment out to disable.
#ARCHIVE_DIR=/mnt/linkbot-archive
